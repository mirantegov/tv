# ============================================================================
# Control-plane central — Mirante Gov
#
# Copie para /opt/mirante/.env.central na VPS e preencha. NÃO comite o
# arquivo preenchido — só este .example é versionado.
#
#   Endereço final:  https://cp.<BASE_DOMAIN>   (rota gerada pelo gen-caddyfile.sh)
#   Um único central serve TODOS os tenants (stage + production).
# ============================================================================

# Host do central = cp.<BASE_DOMAIN>
BASE_DOMAIN=tv.mirantegov.cloud

# --- Banco central (Postgres em container, volume próprio) -----------------
CENTRAL_DB_PASSWORD=                  # SENHA FORTE — openssl rand -hex 16

# --- Segredos --------------------------------------------------------------
JWT_SECRET=                           # tokens de sessão — openssl rand -hex 32
# Assina o data-token (RLS) validado pelo PostgREST dos tenants. TEM de ser
# IGUAL ao PGRST_JWT_SECRET de cada .env.<slug>. Mínimo 32 bytes (o PostgREST
# rejeita HS256 com chave menor): openssl rand -hex 32
PGRST_JWT_SECRET=

# --- CORS: origens (fronts) autorizadas a falar com o central --------------
# Inclua TODOS os tenants (stage e production) — sem a origem aqui, o login
# daquele tenant falha com "Sem conexão com o servidor".
CORS_ORIGIN=https://stage.tv.mirantegov.cloud,https://palotina.tv.mirantegov.cloud

# --- Admin do console /admin (semeado no start do container) ---------------
ADMIN_LOGIN=admin
ADMIN_SENHA=                          # 8+ caracteres
ADMIN_NOME=Administrador

PORT=8080
