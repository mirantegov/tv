DATABASE_URL=postgres://central:central@central-db:5432/central
JWT_SECRET=troque-isto-em-producao
PORT=8080
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-isto
ADMIN_NOME=Administrador
# CORS_ORIGIN: lista de origens permitidas separadas por vírgula
CORS_ORIGIN=https://admin.tv.mirantegov.cloud
# PGRST_JWT_SECRET: deve bater com o PGRST_JWT_SECRET do PostgREST do tenant.
# IMPORTANTE: mínimo 32 bytes (256 bits) — o PostgREST rejeita HS256 com chave
# menor (JWSInvalidSignature). Gere com: openssl rand -hex 32
PGRST_JWT_SECRET=troque-isto-igual-ao-do-tenant-min-32-bytes
